{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "scheme": "myapp",
    "orientation": "portrait",
    "splash": {
      "image": "./constants/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "com.shivam.spendly",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.shivam.spendly",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./constants/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0b874328-bf19-46bc-8aad-3c3df3b6b04f"
      }
    },
    "owner": "shivam0904s-organization"
  }
}
